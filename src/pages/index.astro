---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/siteConfig.json';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft && new Date(post.data.pubDate) <= now)
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf();
  });

const postsPerPage = siteConfig.postsPerPage || 6;

// 自動從文章內容萃取「前 5 行文字」，完整保留換行節奏
function getFirst5Lines(body: string, fallbackDesc: string) {
  if (!body) return fallbackDesc || '';
  let text = body
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<iframe[\s\S]*?<\/iframe>/gi, '')
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/p>/gi, '\n')
    .replace(/<\/div>/gi, '\n')
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&');

  let lines = text
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l.length > 0 && !l.startsWith('!['))
    .slice(0, 5);

  return lines.length > 0 ? lines.join('\n') : (fallbackDesc || '');
}
---

<BaseLayout>
<div id="filterStatusBanner" style="display: none; background: var(--bg-main); padding: 12px 18px; border-radius: 8px; margin-bottom: 22px; justify-content: space-between; align-items: center;">
  <span id="filterStatusText" style="font-weight: 700;"></span>
  <a href="/" style="font-size: 0.88rem; color: var(--milk-tea-dark); font-weight: 600;">✕ 清除篩選返回全部</a>
</div>

<div class="posts-list" id="postsList" data-per-page={postsPerPage}>
{posts.map((post) => {
  const altText = (post.data.seo && post.data.seo.imageAlt) ? post.data.seo.imageAlt : post.data.title;
  const views = post.data.baseViews || 5280;
  const fiveLines = getFirst5Lines(post.body, post.data.description);
  const tags = (post.data.tags || []).slice(0, 8);

  return (
    <article 
      class="post-card" 
      data-category={post.data.category} 
      data-tags={(post.data.tags || []).join(',')}
      data-slug={post.slug}
      style="overflow: hidden;"
    >
      <h2 class="post-card-title">
        {post.data.pinned && <span class="pinned-badge">📌 置頂精選</span>}
        <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
      </h2>

      <div class="post-meta" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px;">
        <span class="category-badge">{post.data.category}</span>
        <span>📅 {new Date(post.data.pubDate).toLocaleDateString('zh-TW')}</span>
        <span class="views-badge" style="background: #FAF3EB; color: #9C7A54; border: 1px solid #E6D5C3; padding: 2px 10px; border-radius: 6px; font-weight: 700; font-size: 0.85rem;">
          🔥 <span class="card-view-count" data-slug={post.slug} data-base={views}>{views.toLocaleString()}</span> 次觀看
        </span>
        {tags.map((tag: string) => (
          <a href={`/?tag=${encodeURIComponent(tag)}`} class="tag-pill">#{tag}</a>
        ))}
      </div>

      {post.data.heroImage && (
        <a href={`/posts/${post.slug}/`} style="display: flex; justify-content: center; align-items: center; width: 100%; margin-bottom: 18px; border-radius: 12px; overflow: hidden;">
          <img 
            src={post.data.heroImage} 
            alt={altText} 
            loading="lazy" 
            referrerpolicy="no-referrer"
            style="display: block; width: auto; max-width: 100%; height: auto; max-height: 520px; object-fit: contain; border-radius: 12px; margin: 0 auto;" 
          />
        </a>
      )}

      <p style="color: var(--text-primary); margin: 0 auto 18px auto; white-space: pre-line; line-height: 1.95; text-align: center;">
        {fiveLines}
      </p>

      <div style="text-align: center;">
        <a href={`/posts/${post.slug}/`} class="read-more-btn">閱讀完整文章 →</a>
      </div>
    </article>
  );
})}
</div>

<div id="paginationBar" class="pagination-bar" style="display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 28px;"></div>

<script is:inline>
// 1. 同步更新每張文章卡片的觀看人數 (5000+ 起跳加上瀏覽累加)
document.querySelectorAll('.card-view-count').forEach((el) => {
  const slug = el.getAttribute('data-slug');
  const base = parseInt(el.getAttribute('data-base') || '5280', 10);
  const extra = parseInt(localStorage.getItem('views_' + slug) || '0', 10);
  el.textContent = (base + extra).toLocaleString();
});

// 2. 分類、標籤篩選與智慧縮略分頁器
const params = new URLSearchParams(window.location.search);
const selectedCategory = params.get('category');
const selectedTag = params.get('tag');
const filterBanner = document.getElementById('filterStatusBanner');
const filterText = document.getElementById('filterStatusText');
const allCards = Array.from(document.querySelectorAll('.post-card'));
const postsListEl = document.getElementById('postsList');
const paginationBar = document.getElementById('paginationBar');
const perPage = parseInt(postsListEl.dataset.perPage || '6', 10);

let filteredCards = allCards;

if (selectedCategory) {
  filterBanner.style.display = 'flex';
  filterText.innerText = `📂 目前顯示分類：「${selectedCategory}」`;
  filteredCards = allCards.filter(c => c.dataset.category === selectedCategory);
} else if (selectedTag) {
  filterBanner.style.display = 'flex';
  filterText.innerText = `🏷️ 目前顯示標籤：「#${selectedTag}」`;
  filteredCards = allCards.filter(c => (c.dataset.tags || '').split(',').includes(selectedTag));
}

function renderPage(page) {
  allCards.forEach(c => c.style.display = 'none');
  const totalPages = Math.ceil(filteredCards.length / perPage) || 1;
  if (page < 1) page = 1;
  if (page > totalPages) page = totalPages;

  const start = (page - 1) * perPage;
  const end = start + perPage;
  filteredCards.slice(start, end).forEach(c => c.style.display = 'block');

  paginationBar.innerHTML = '';
  if (totalPages > 1) {
    const createBtn = (label, targetPage, isActive = false, isDisabled = false) => {
      const btn = document.createElement('button');
      btn.className = 'page-btn' + (isActive ? ' active' : '');
      btn.innerText = label;
      btn.disabled = isDisabled;
      if (isDisabled) btn.style.opacity = '0.45';
      if (!isDisabled && !isActive) {
        btn.onclick = () => {
          renderPage(targetPage);
          window.scrollTo({ top: 300, behavior: 'smooth' });
        };
      }
      return btn;
    };

    // 上一頁
    paginationBar.appendChild(createBtn('‹ 上一頁', page - 1, false, page === 1));

    // 智慧縮略頁碼（最多顯示首尾頁與當前頁前後 1 頁，中間以 ⋯ 縮略，絕不整排擠爆）
    const pageList = [];
    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) {
        pageList.push(i);
      } else if (pageList[pageList.length - 1] !== '...') {
        pageList.push('...');
      }
    }

    pageList.forEach(p => {
      if (p === '...') {
        const dots = document.createElement('span');
        dots.innerText = '⋯';
        dots.style.padding = '0 6px';
        dots.style.color = '#8C7A6B';
        dots.style.fontWeight = '700';
        paginationBar.appendChild(dots);
      } else {
        paginationBar.appendChild(createBtn(String(p), p, p === page, false));
      }
    });

    // 下一頁
    paginationBar.appendChild(createBtn('下一頁 ›', page + 1, false, page === totalPages));
  }
}

renderPage(1);

const searchInput = document.getElementById('searchInput');
if (searchInput) {
  searchInput.addEventListener('input', e => {
    const keyword = e.target.value.toLowerCase().trim();
    if (!keyword) {
      renderPage(1);
      return;
    }
    paginationBar.innerHTML = '';
    allCards.forEach(card => {
      card.style.display = card.innerText.toLowerCase().includes(keyword) ? 'block' : 'none';
    });
  });
}
</script>
</BaseLayout>
