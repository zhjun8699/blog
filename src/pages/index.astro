---
import { getCollection } from 'astro:content';
import siteConfig from '../data/siteConfig.json';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// 完整對應原本 siteConfig.json 的所有欄位，找回標題、Logo、Banner、頭像與簡介
const siteTitle = siteConfig.title || siteConfig.siteTitle || '哪裏。DOKO';
const siteSubtitle = siteConfig.subtitle || siteConfig.siteSubtitle || '美食情報・旅遊・開箱分享';
const siteDesc = siteConfig.description || siteConfig.siteDescription || siteConfig.bio || '';
const logoImg = siteConfig.logo || siteConfig.logoImage || '';
const bannerImg = siteConfig.banner || siteConfig.bannerImage || '';
const authorName = siteConfig.authorName || siteConfig.author || siteTitle;
const authorAvatar = siteConfig.avatar || siteConfig.authorAvatar || logoImg || 'https://pimg.1px.tw/blog/zhjun8699/logo/844863945586290081.webp';
const authorBio = siteConfig.bio || siteConfig.authorBio || 'Hi！歡迎來到我的部落格，熱愛發掘各地美食、旅遊景點與質感生活好物，分享最真實的體驗紀錄！';
const coopEmail = siteConfig.email || siteConfig.contactEmail || 'k81928@gmail.com';
const igUrl = siteConfig.instagram || siteConfig.instagramUrl || 'https://www.instagram.com/chun._.1997/';
const fbUrl = siteConfig.facebook || siteConfig.facebookUrl || 'https://www.facebook.com/doko2021/';

function fixPixnetUrl(url: string) {
  if (!url) return '';
  let u = url.trim();
  if (/pimg\.1px\.tw\/zhjun8699\/\d+/i.test(u)) {
    u = u.replace('pimg.1px.tw/', 'pic.pimg.tw/');
  }
  return u;
}

function getFirst5Lines(body: string, fallbackDesc: string) {
  if (!body) return fallbackDesc || '';
  let text = body
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<iframe[\s\S]*?<\/iframe>/gi, '')
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/p>/gi, '\n')
    .replace(/<\/div>/gi, '\n')
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&');

  let lines = text
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l.length > 0 && !l.startsWith('!['))
    .slice(0, 5);

  return lines.length > 0 ? lines.join('\n') : (fallbackDesc || '');
}

const rawCategories = siteConfig.categories || [
  "台灣美食",
  "國內外旅遊",
  "質感保養",
  "好物開箱",
  "好物團購"
];
const categories = rawCategories.map((c: any) =>
  typeof c === 'string' ? { name: c, slug: c } : { name: c.name || c.title, slug: c.slug || c.name || c.title }
);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>{siteTitle} | {siteSubtitle}</title>
    <meta name="description" content={siteDesc} />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <script is:inline>
      window.recoverPixnetImg = function(img) {
        if (!img) return;
        const step = parseInt(img.dataset.retryStep || '0', 10);
        const rawUrl = img.dataset.rawSrc || img.getAttribute('src') || '';
        if (!rawUrl) return;
        img.dataset.rawSrc = rawUrl;

        let cleanPath = rawUrl
          .replace(/^https?:\/\/[^/]+\//i, '')
          .replace(/^blog\//i, '');
        let noSuffixPath = cleanPath.replace(/_[nbmsq]\.(jpg|jpeg|png|gif|webp)/i, '.$1');

        if (step === 0) {
          img.dataset.retryStep = '1';
          img.src = 'https://pic.pimg.tw/' + noSuffixPath;
        } else if (step === 1) {
          img.dataset.retryStep = '2';
          img.src = 'https://pimg.1px.tw/' + noSuffixPath;
        } else if (step === 2) {
          img.dataset.retryStep = '3';
          img.src = 'https://pimg.1px.tw/blog/' + noSuffixPath;
        } else if (step === 3) {
          img.dataset.retryStep = '4';
          img.src = 'https://s.pixfs.net/' + cleanPath;
        } else if (step === 4) {
          img.dataset.retryStep = '5';
          img.src = 'https://wsrv.nl/?url=' + encodeURIComponent('pic.pimg.tw/' + noSuffixPath);
        } else if (step === 5) {
          img.dataset.retryStep = '6';
          img.src = 'https://web.archive.org/web/2/https://pic.pimg.tw/' + cleanPath;
        } else {
          const linkWrap = img.closest('.post-thumb-link');
          if (linkWrap) linkWrap.style.display = 'none';
          else img.style.display = 'none';
        }
      };
    </script>

    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
        background-color: #FAF6F0;
        color: #3D352E;
        overflow-x: hidden;
        padding-bottom: 80px;
      }

      .site-header {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #E6D5C3;
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 14px 28px;
      }
      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #3D352E;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: 1.5px;
      }
      .brand-logo img {
        height: 42px;
        width: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #E6D5C3;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      .nav-btn {
        background: transparent;
        border: none;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 15px;
        font-weight: 700;
        color: #5C5046;
        cursor: pointer;
        transition: all 0.2s;
      }
      .nav-btn:hover, .nav-btn.active {
        background: #E6D5C3;
        color: #3D352E;
      }
      .search-box input {
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid #D5C3B0;
        background: #FAF6F0;
        font-size: 14px;
        width: 210px;
        outline: none;
      }

      .hero-banner-wrap {
        max-width: 1200px;
        margin: 24px auto 0;
        padding: 0 20px;
      }
      .hero-banner {
        width: 100%;
        max-height: 320px;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(61, 53, 46, 0.08);
      }
      .hero-banner img {
        width: 100%;
        height: 100%;
        max-height: 320px;
        object-fit: cover;
        display: block;
      }

      .main-layout {
        max-width: 1200px;
        margin: 28px auto 60px;
        padding: 0 20px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 32px;
        align-items: start;
      }
      @media (max-width: 960px) {
        .main-layout {
          grid-template-columns: 1fr;
        }
      }

      .posts-grid {
        display: flex;
        flex-direction: column;
        gap: 32px;
      }
      .post-card {
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 28px 32px;
        box-shadow: 0 4px 20px rgba(61, 53, 46, 0.04);
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
      }
      @media (max-width: 640px) {
        .post-card { padding: 20px 18px; }
      }
      .post-card:hover {
        box-shadow: 0 8px 28px rgba(61, 53, 46, 0.08);
      }

      .post-title-box {
        background: #F4ECE4;
        border-left: 5px solid #C8AD90;
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .post-title-box h2 {
        margin: 0;
        font-size: 20px;
        line-height: 1.55;
        font-weight: 700;
        word-break: break-word;
      }
      .post-title-box a {
        color: #3D352E;
        text-decoration: none;
      }
      .post-title-box a:hover {
        color: #9C7A54;
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
        font-size: 13px;
        color: #7A6E65;
      }
      .cat-badge {
        background: #C8AD90;
        color: #FFFFFF;
        padding: 4px 11px;
        border-radius: 6px;
        font-weight: 600;
      }
      .views-badge {
        background: #FAF3EB;
        color: #9C7A54;
        border: 1px solid #E6D5C3;
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 700;
      }
      .tag-pill {
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
        color: #6E6259;
        padding: 2px 9px;
        border-radius: 12px;
        font-size: 12px;
      }

      .post-thumb-link {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin: 0 auto 22px;
        border-radius: 12px;
        overflow: hidden;
        background: transparent;
      }
      .post-thumb-link img {
        display: block;
        max-width: 100%;
        width: auto;
        max-height: 520px;
        height: auto;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(61, 53, 46, 0.06);
        transition: transform 0.3s ease;
      }
      .post-thumb-link:hover img {
        transform: scale(1.015);
      }

      .post-excerpt-5lines {
        font-size: 16px;
        line-height: 2;
        color: #4A4038;
        margin: 0 auto 22px;
        white-space: pre-line;
        text-align: center;
        font-weight: 500;
        max-width: 92%;
      }

      .card-footer {
        text-align: center;
        padding-top: 8px;
      }
      .read-more-btn {
        display: inline-block;
        padding: 9px 24px;
        background: #FAF6F0;
        border: 1px solid #C8AD90;
        color: #3D352E;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
      }
      .read-more-btn:hover {
        background: #C8AD90;
        color: #FFFFFF;
      }

      .pagination-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 36px;
        flex-wrap: wrap;
      }
      .page-btn {
        min-width: 40px;
        height: 40px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid #E6D5C3;
        background: #FFFFFF;
        color: #5C5046;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .page-btn:hover:not(:disabled) {
        background: #F4ECE4;
        border-color: #C8AD90;
      }
      .page-btn.active {
        background: #C8AD90;
        color: #FFFFFF;
        border-color: #C8AD90;
      }
      .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .page-dots {
        color: #9C8E80;
        font-weight: 700;
        padding: 0 4px;
      }

      .sidebar-card {
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 28px 22px;
        text-align: center;
        position: sticky;
        top: 86px;
        box-shadow: 0 4px 20px rgba(61, 53, 46, 0.04);
      }
      .author-avatar {
        width: 104px;
        height: 104px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #E6D5C3;
        margin-bottom: 14px;
      }
      .author-name {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 10px 0;
        color: #3D352E;
      }
      .author-bio {
        font-size: 14px;
        line-height: 1.75;
        color: #5C5046;
        margin-bottom: 14px;
        text-align: left;
      }
      .coop-box {
        font-size: 13px;
        color: #7A6E65;
        background: #FAF6F0;
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 16px;
        border: 1px dashed #E6D5C3;
        text-align: left;
      }
      .ig-btn {
        display: block;
        width: 100%;
        padding: 12px;
        background: #A98B6F;
        color: #FFFFFF;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 14px;
        transition: background 0.2s;
      }
      .ig-btn:hover { background: #8F7256; }

      .floating-admin-bar {
        position: fixed;
        bottom: 20px;
        right: 24px;
        z-index: 9999;
        background: rgba(38, 33, 29, 0.95);
        backdrop-filter: blur(8px);
        padding: 8px 14px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
        border: 1px solid rgba(200, 173, 144, 0.4);
      }
      .admin-status {
        color: #E6D5C3;
        font-size: 13px;
        font-weight: 700;
        padding: 0 6px;
      }
      .admin-pill {
        background: #FAF6F0;
        color: #3D352E;
        text-decoration: none;
        border: none;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .admin-pill.gold {
        background: #E6C89C;
        color: #2B231D;
      }
      .admin-pill:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          {logoImg && <img src={logoImg} alt={siteTitle} referrerpolicy="no-referrer" onerror="this.style.display='none'" />}
          <span>{siteTitle}</span>
        </a>
        <nav class="nav-links">
          <button class="nav-btn active" data-cat="all">全部文章 ({posts.length})</button>
          {categories.map((c: any) => (
            <button class="nav-btn" data-cat={c.slug}>{c.name}</button>
          ))}
        </nav>
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="搜尋文章關鍵字..." />
        </div>
      </div>
    </header>

    {bannerImg && (
      <div class="hero-banner-wrap">
        <div class="hero-banner">
          <img src={bannerImg} alt={siteTitle} referrerpolicy="no-referrer" onerror="this.parentElement.parentElement.style.display='none'" />
        </div>
      </div>
    )}

    <main class="main-layout">
      <div>
        <section class="posts-grid" id="postsContainer">
          {posts.map((post) => {
            const d = new Date(post.data.pubDate);
            const dateStr = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
            const views = post.data.baseViews || 5280;
            const tags = (post.data.tags || []).slice(0, 6);
            const fiveLines = getFirst5Lines(post.body, post.data.description);
            const heroUrl = fixPixnetUrl(post.data.heroImage);

            return (
              <article class="post-card" data-category={post.data.category} data-title={post.data.title} data-slug={post.slug}>
                <div class="post-title-box">
                  <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
                </div>

                <div class="post-meta">
                  <span class="cat-badge">{post.data.category || '精選文章'}</span>
                  <span>📅 {dateStr}</span>
                  <span class="views-badge">🔥 <span class="view-count" data-slug={post.slug} data-base={views}>{views.toLocaleString()}</span> 次觀看</span>
                  {tags.map((t: string) => <span class="tag-pill">#{t}</span>)}
                </div>

                {heroUrl && (
                  <a href={`/posts/${post.slug}/`} class="post-thumb-link">
                    <img
                      src={heroUrl}
                      alt={post.data.title}
                      referrerpolicy="no-referrer"
                      onerror="window.recoverPixnetImg(this)"
                    />
                  </a>
                )}

                <div class="post-excerpt-5lines">{fiveLines}</div>

                <div class="card-footer">
                  <a href={`/posts/${post.slug}/`} class="read-more-btn">(繼續閱讀...)</a>
                </div>
              </article>
            );
          })}
        </section>

        <nav class="pagination-wrap" id="paginationWrap"></nav>
      </div>

      <aside class="sidebar-card">
        {authorAvatar && (
          <img
            src={authorAvatar}
            alt={authorName}
            class="author-avatar"
            referrerpolicy="no-referrer"
            onerror="this.src='https://pimg.1px.tw/blog/zhjun8699/logo/844863945586290081.webp'"
          />
        )}
        <h3 class="author-name">{authorName}</h3>
        <p class="author-bio">{authorBio}</p>
        <div class="coop-box">
          📩 合作邀約歡迎來信或私訊 IG：<br />
          <strong>{coopEmail}</strong>
        </div>
        {igUrl && (
          <a href={igUrl} target="_blank" class="ig-btn">📸 追蹤我的 Instagram</a>
        )}
        {fbUrl && (
          <a href={fbUrl} target="_blank" class="ig-btn" style="background:#8C7A6B;">👍 追蹤 Facebook 粉專</a>
        )}
      </aside>
    </main>

    <div class="floating-admin-bar">
      <span class="admin-status">🛡️ 管理員模式</span>
      <a href="/admin/#/collections/blog/new" class="admin-pill">＋ 新增文章</a>
      <a href="/admin/#/collections/settings/entries/siteConfig" class="admin-pill gold">🎨 修改版面/圖片/分類</a>
      <a href="/admin/" class="admin-pill">⚙️ 後台首頁</a>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.post-thumb-link img').forEach((img) => {
          if (img.complete && img.naturalWidth === 0) {
            window.recoverPixnetImg(img);
          }
        });

        document.querySelectorAll('.view-count').forEach((el) => {
          const slug = el.getAttribute('data-slug');
          const base = parseInt(el.getAttribute('data-base') || '5280', 10);
          const extra = parseInt(localStorage.getItem('views_' + slug) || '0', 10);
          el.textContent = (base + extra).toLocaleString();
        });

        const ITEMS_PER_PAGE = 10;
        let currentPage = 1;
        let currentCat = 'all';
        let currentQuery = '';

        const allCards = Array.from(document.querySelectorAll('.post-card'));
        const paginationWrap = document.getElementById('paginationWrap');

        function getFilteredCards() {
          return allCards.filter((c) => {
            const cardCat = c.getAttribute('data-category') || '';
            const title = (c.getAttribute('data-title') || '').toLowerCase();
            let matchCat = currentCat === 'all' || cardCat.includes(currentCat);
            if (!matchCat && currentCat.includes('旅遊') && cardCat.includes('旅遊')) matchCat = true;
            if (!matchCat && currentCat.includes('保養') && (cardCat.includes('住宿') || cardCat.includes('保養'))) matchCat = true;
            const matchQuery = !currentQuery || title.includes(currentQuery);
            return matchCat && matchQuery;
          });
        }

        function renderPage() {
          const filtered = getFilteredCards();
          const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
          if (currentPage > totalPages) currentPage = totalPages;

          allCards.forEach((c) => (c.style.display = 'none'));
          const start = (currentPage - 1) * ITEMS_PER_PAGE;
          const end = start + ITEMS_PER_PAGE;
          filtered.slice(start, end).forEach((c) => (c.style.display = 'block'));

          renderPaginationButtons(totalPages);
        }

        function renderPaginationButtons(totalPages) {
          if (!paginationWrap) return;
          paginationWrap.innerHTML = '';
          if (totalPages <= 1) return;

          const createBtn = (label, targetPage, disabled = false, active = false) => {
            const b = document.createElement('button');
            b.className = 'page-btn' + (active ? ' active' : '');
            b.textContent = label;
            b.disabled = disabled;
            if (!disabled && !active) {
              b.addEventListener('click', () => {
                currentPage = targetPage;
                renderPage();
                window.scrollTo({ top: 0, behavior: 'smooth' });
              });
            }
            return b;
          };

          paginationWrap.appendChild(createBtn('‹ 上一頁', currentPage - 1, currentPage === 1));

          const pages = [];
          for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
              pages.push(i);
            } else if (pages[pages.length - 1] !== '...') {
              pages.push('...');
            }
          }

          pages.forEach((p) => {
            if (p === '...') {
              const span = document.createElement('span');
              span.className = 'page-dots';
              span.textContent = '⋯';
              paginationWrap.appendChild(span);
            } else {
              paginationWrap.appendChild(createBtn(String(p), p, false, p === currentPage));
            }
          });

          paginationWrap.appendChild(createBtn('下一頁 ›', currentPage + 1, currentPage === totalPages));
        }

        const navBtns = document.querySelectorAll('.nav-btn');
        navBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            navBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentCat = btn.getAttribute('data-cat') || 'all';
            currentPage = 1;
            renderPage();
          });
        });

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            currentQuery = e.target.value.toLowerCase().trim();
            currentPage = 1;
            renderPage();
          });
        }

        renderPage();
      });
    </script>
  </body>
</html>
