  <body>
    <!-- 頂部閱讀進度條 -->
    <div id="reading-progress"></div>

    <!-- 頂部動態跑馬燈 -->
    <div class="marquee-bar">
      <div class="marquee-track">{marqueeText}</div>
    </div>

    <!-- 導覽列 -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          {logoImg && <img src={logoImg} alt={siteTitle} referrerpolicy="no-referrer" onerror="this.style.display='none'" />}
          <span>{siteTitle}</span>
        </a>
        <nav class="nav-links">
          <button class="nav-btn active" data-cat="all">全部文章</button>
          {navCategories.map((c) => (
            <button class="nav-btn" data-cat={c.name}>{c.name}</button>
          ))}
        </nav>
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="搜尋文章關鍵字..." />
        </div>
      </div>
    </header>

    {bannerImg && (
      <div class="hero-banner-wrap">
        <div class="hero-banner">
          <img src={bannerImg} alt={siteTitle} referrerpolicy="no-referrer" onerror="this.parentElement.parentElement.style.display='none'" />
        </div>
      </div>
    )}

    <main class="main-layout">
      <!-- 左側：文章卡片列表 -->
      <div>
        <section class="posts-grid" id="postsContainer">
          {posts.map((post) => {
            const d = new Date(post.data.pubDate);
            const dateStr = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
            const views = post.data.baseViews || 5280;
            const tags = (post.data.tags || []).slice(0, 8);
            const fiveLines = getFirst5Lines(post.body, post.data.description);
            const heroUrl = fixPixnetUrl(post.data.heroImage);

            return (
              <article class="post-card" data-category={post.data.category} data-title={post.data.title} data-slug={post.slug}>
                <div class="post-title-box">
                  <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
                </div>

                <div class="post-meta">
                  <span class="cat-badge">{post.data.category || '台灣美食'}</span>
                  <span>📅 {dateStr}</span>
                  <span class="views-badge">🔥 <span class="view-count" data-slug={post.slug} data-base={views}>{views.toLocaleString()}</span> 次觀看</span>
                  {tags.map((t: string) => <span class="tag-pill">#{t}</span>)}
                </div>

                {heroUrl && (
                  <a href={`/posts/${post.slug}/`} class="post-thumb-link">
                    <img
                      src={heroUrl}
                      alt={post.data.title}
                      referrerpolicy="no-referrer"
                      onerror="window.recoverPixnetImg(this)"
                    />
                  </a>
                )}

                <div class="post-excerpt-5lines">{fiveLines}</div>

                <div class="card-footer">
                  <a href={`/posts/${post.slug}/`} class="read-more-btn">(繼續閱讀...)</a>
                </div>
              </article>
            );
          })}
        </section>

        <!-- 智慧縮略分頁器 -->
        <nav class="pagination-wrap" id="paginationWrap"></nav>
      </div>

      <!-- 右側：完整 6 大模組側邊欄 -->
      <aside class="sidebar-column">
        <!-- 模組 1：個人簡介與 Instagram 連結 -->
        <div class="sidebar-box">
          <img
            src={authorAvatar}
            alt={authorName}
            class="author-avatar"
            referrerpolicy="no-referrer"
            onerror="this.src='https://pimg.1px.tw/blog/zhjun8699/logo/844863945586290081.webp'"
          />
          <p class="author-bio">{authorBio}</p>
          <div class="coop-line">
            📩 合作邀約歡迎來信或私訊：<br />
            <strong>{coopEmail}</strong>
          </div>
          <a href={igUrl} target="_blank" class="ig-btn">📸 追蹤我的 Instagram</a>

          <div class="box-title" style="margin-top:10px;">Instagram 最新動態</div>
          <div style="border-radius:12px;overflow:hidden;border:1px solid #EFE6DD;background:#FAF6F0;">
            <iframe
              src="https://www.instagram.com/chun._.1997/embed"
              width="100%"
              height="380"
              frameborder="0"
              scrolling="no"
              allowtransparency="true"
              style="display:block;"
            ></iframe>
          </div>
        </div>

        <!-- 模組 2：參觀人氣 (單日 / 累積) -->
        <div class="sidebar-box">
          <h4 class="box-title">📊 參觀人氣統計</h4>
          <div class="hits-grid">
            <div class="hit-item">
              <div class="hit-label">本日人氣</div>
              <div class="hit-num" id="dailyHits">386</div>
            </div>
            <div class="hit-item">
              <div class="hit-label">累積人氣</div>
              <div class="hit-num" id="totalHits">{totalBaseViews.toLocaleString()}</div>
            </div>
          </div>
        </div>

        <!-- 模組 3：文章分類 -->
        <div class="sidebar-box">
          <h4 class="box-title">📂 文章分類</h4>
          <ul class="side-cat-list">
            <li>
              <button class="side-cat-btn" data-side-cat="all">
                <span>全部文章</span>
                <span>({posts.length})</span>
              </button>
            </li>
            {navCategories.map((c) => {
              const count = posts.filter((p) => {
                const cat = p.data.category || '';
                return c.match.some((m) => cat.includes(m));
              }).length;
              return (
                <li>
                  <button class="side-cat-btn" data-side-cat={c.name}>
                    <span>{c.name}</span>
                    <span>({count})</span>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- 模組 4：熱門文章 Top 5 -->
        <div class="sidebar-box">
          <h4 class="box-title">🔥 熱門文章排行</h4>
          <ul class="side-post-list">
            {hotPosts.map((p, i) => (
              <li class="side-post-item">
                <a href={`/posts/${p.slug}/`}>
                  <span class="rank-num">{i + 1}</span>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 模組 5：最新文章 Top 5 -->
        <div class="sidebar-box">
          <h4 class="box-title">✨ 最新發布文章</h4>
          <ul class="side-post-list">
            {latestPosts.map((p) => (
              <li class="side-post-item">
                <a href={`/posts/${p.slug}/`}>
                  <span>• {p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 模組 6：精選推薦 / 廣告版位 -->
        <div class="sidebar-box">
          <h4 class="box-title">📣 精選推薦 / 廣告</h4>
          {adImage ? (
            <a href={adLink} target="_blank">
              <img src={adImage} alt="精選推薦" style="width:100%;border-radius:10px;" />
            </a>
          ) : (
            <div style="background:#FAF6F0;border:1px dashed #C8AD90;border-radius:12px;padding:18px;text-align:center;color:#7A6E65;font-size:13.5px;line-height:1.7;">
              <strong>✨ 哪裏。DOKO 合作專區 ✨</strong><br />
              美食探店・旅遊體驗・質感好物開箱<br />
              歡迎品牌洽談合作：<br />
              <a href={`mailto:${coopEmail}`} style="color:#9C7A54;font-weight:700;">{coopEmail}</a>
            </div>
          )}
        </div>
      </aside>
    </main>

    <!-- 回到頂部按鈕 -->
    <button id="backToTop" title="回到頂部">↑</button>

    <!-- 右下角管理員專屬懸浮工具列 -->
    <div class="floating-admin-bar">
      <span class="admin-status">🛡️ 管理員模式</span>
      <a href="/admin/#/collections/blog/new" class="admin-pill">＋ 新增文章</a>
      <a href="/admin/#/collections/settings/entries/siteConfig" class="admin-pill gold">🎨 修改版面/圖片/分類</a>
      <a href="/admin/" class="admin-pill">⚙️ 後台首頁</a>
      <button id="adminLogoutBtn" class="admin-pill dark">登出</button>
    </div>

    <script is:inline define:vars={{ totalBaseViews }}>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. 閱讀進度條 & 回頂部按鈕
        const progressBar = document.getElementById('reading-progress');
        const backToTopBtn = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (progressBar) progressBar.style.width = percent + '%';
          if (backToTopBtn) {
            backToTopBtn.style.display = scrollTop > 300 ? 'flex' : 'none';
          }
        });
        if (backToTopBtn) {
          backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // 2. 巡檢首圖破圖救援
        document.querySelectorAll('.post-thumb-link img').forEach((img) => {
          if (img.complete && img.naturalWidth === 0) {
            window.recoverPixnetImg(img);
          }
        });

        // 3. 更新單篇文章觀看數 & 側邊欄本日/累積人氣
        let extraSum = 0;
        document.querySelectorAll('.view-count').forEach((el) => {
          const slug = el.getAttribute('data-slug');
          const base = parseInt(el.getAttribute('data-base') || '5280', 10);
          const extra = parseInt(localStorage.getItem('views_' + slug) || '0', 10);
          extraSum += extra;
          el.textContent = (base + extra).toLocaleString();
        });

        const todayKey = 'daily_hits_' + new Date().toISOString().slice(0, 10);
        const dailyVal = parseInt(localStorage.getItem(todayKey) || '386', 10) + 1;
        localStorage.setItem(todayKey, String(dailyVal));
        const dailyEl = document.getElementById('dailyHits');
        const totalEl = document.getElementById('totalHits');
        if (dailyEl) dailyEl.textContent = dailyVal.toLocaleString();
        if (totalEl) totalEl.textContent = (totalBaseViews + extraSum + dailyVal).toLocaleString();

        // 4. 智慧縮略分頁邏輯
        const ITEMS_PER_PAGE = 10;
        let currentPage = 1;
        let currentCat = 'all';
        let currentQuery = '';

        const allCards = Array.from(document.querySelectorAll('.post-card'));
        const paginationWrap = document.getElementById('paginationWrap');

        function matchCategory(cardCat, selected) {
          if (selected === 'all') return true;
          if (cardCat.includes(selected)) return true;
          if (selected === '台灣美食' && /美食|食記|Eat/.test(cardCat)) return true;
          if (selected === '國內外旅遊' && /旅遊|Travel/.test(cardCat)) return true;
          if (selected === '質感保養' && /保養|住宿|彩妝|Beauty/.test(cardCat)) return true;
          if (selected === '好物開箱' && /開箱|生活|攝影|寵物/.test(cardCat)) return true;
          if (selected === '好物團購' && /團購/.test(cardCat)) return true;
          return false;
        }

        function getFilteredCards() {
          return allCards.filter((c) => {
            const cardCat = c.getAttribute('data-category') || '';
            const title = (c.getAttribute('data-title') || '').toLowerCase();
            return matchCategory(cardCat, currentCat) && (!currentQuery || title.includes(currentQuery));
          });
        }

        function renderPage() {
          const filtered = getFilteredCards();
          const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
          if (currentPage > totalPages) currentPage = totalPages;

          allCards.forEach((c) => (c.style.display = 'none'));
          const start = (currentPage - 1) * ITEMS_PER_PAGE;
          const end = start + ITEMS_PER_PAGE;
          filtered.slice(start, end).forEach((c) => (c.style.display = 'block'));

          renderPaginationButtons(totalPages);
        }

        function renderPaginationButtons(totalPages) {
          if (!paginationWrap) return;
          paginationWrap.innerHTML = '';
          if (totalPages <= 1) return;

          const createBtn = (label, targetPage, disabled = false, active = false) => {
            const b = document.createElement('button');
            b.className = 'page-btn' + (active ? ' active' : '');
            b.textContent = label;
            b.disabled = disabled;
            if (!disabled && !active) {
              b.addEventListener('click', () => {
                currentPage = targetPage;
                renderPage();
                window.scrollTo({ top: 0, behavior: 'smooth' });
              });
            }
            return b;
          };

          paginationWrap.appendChild(createBtn('‹ 上一頁', currentPage - 1, currentPage === 1));

          const pages = [];
          for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
              pages.push(i);
            } else if (pages[pages.length - 1] !== '...') {
              pages.push('...');
            }
          }

          pages.forEach((p) => {
            if (p === '...') {
              const span = document.createElement('span');
              span.className = 'page-dots';
              span.textContent = '⋯';
              paginationWrap.appendChild(span);
            } else {
              paginationWrap.appendChild(createBtn(String(p), p, false, p === currentPage));
            }
          });

          paginationWrap.appendChild(createBtn('下一頁 ›', currentPage + 1, currentPage === totalPages));
        }

        const navBtns = document.querySelectorAll('.nav-btn');
        function setCategoryFilter(cat) {
          currentCat = cat;
          currentPage = 1;
          navBtns.forEach((b) => {
            b.classList.toggle('active', b.getAttribute('data-cat') === cat);
          });
          renderPage();
        }

        navBtns.forEach((btn) => {
          btn.addEventListener('click', () => setCategoryFilter(btn.getAttribute('data-cat') || 'all'));
        });

        document.querySelectorAll('.side-cat-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            setCategoryFilter(btn.getAttribute('data-side-cat') || 'all');
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            currentQuery = e.target.value.toLowerCase().trim();
            currentPage = 1;
            renderPage();
          });
        }

        const logoutBtn = document.getElementById('adminLogoutBtn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', () => {
            if (window.netlifyIdentity) window.netlifyIdentity.logout();
            alert('已登出管理員模式');
          });
        }

        renderPage();
      });
    </script>
  </body>
</html>
