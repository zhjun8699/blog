---
import { getCollection } from 'astro:content';
import siteConfig from '../../data/siteConfig.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const sortedPosts = allPosts
  .filter((p: any) => p.data.draft !== true)
  .sort((a: any, b: any) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const d = new Date(post.data.pubDate);
const dateStr = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
const baseViews = post.data.baseViews || 5280;

const siteTitle = siteConfig.title || siteConfig.siteTitle || '哪裏。DOKO';
const logoImg = siteConfig.logo || siteConfig.logoImage || '';
const marqueeText = siteConfig.marquee || siteConfig.announcement || '✨ 歡迎來到 哪裏。DOKO！最新美食探店、國內外旅遊攻略與質感好物開箱持續更新中～ 合作邀約歡迎來信：k81928@gmail.com ✨';
const authorName = siteConfig.authorName || siteConfig.author || '哪裏。DOKO';
const authorAvatar = siteConfig.avatar || siteConfig.authorAvatar || logoImg || 'https://pimg.1px.tw/blog/zhjun8699/logo/844863945586290081.webp';
const authorBio = siteConfig.bio || siteConfig.authorBio || 'Hi！歡迎來到我的部落格\n熱愛發掘各地美食、旅遊景點與質感生活好物，分享最真實紀錄！';
const coopEmail = siteConfig.email || siteConfig.contactEmail || 'k81928@gmail.com';
const igUrl = siteConfig.instagram || siteConfig.instagramUrl || 'https://www.instagram.com/chun._.1997/';

// 相關文章推薦（同分類優先，取 4 篇）
const relatedPosts = sortedPosts
  .filter((p: any) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 4);
if (relatedPosts.length < 4) {
  const more = sortedPosts.filter((p: any) => p.slug !== post.slug && !relatedPosts.includes(p)).slice(0, 4 - relatedPosts.length);
  relatedPosts.push(...more);
}

const hotPosts = [...sortedPosts].sort((a: any, b: any) => (b.data.baseViews || 5000) - (a.data.baseViews || 5000)).slice(0, 5);
const latestPosts = sortedPosts.slice(0, 5);
const totalBaseViews = sortedPosts.reduce((sum: number, p: any) => sum + (p.data.baseViews || 5280), 128500);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>{post.data.title} | {siteTitle}</title>
    <meta name="description" content={post.data.description} />
    <script is:inline>
      window.recoverPixnetImg = function(img) {
        if (!img) return;
        const step = parseInt(img.dataset.retryStep || '0', 10);
        const rawUrl = img.dataset.rawSrc || img.getAttribute('src') || '';
        if (!rawUrl) return;
        img.dataset.rawSrc = rawUrl;

        let cleanPath = rawUrl.replace(/^https?:\/\/[^/]+\//i, '').replace(/^blog\//i, '');
        let noSuffixPath = cleanPath.replace(/_[nbmsq]\.(jpg|jpeg|png|gif|webp)/i, '.$1');

        if (step === 0) {
          img.dataset.retryStep = '1';
          img.src = 'https://pic.pimg.tw/' + noSuffixPath;
        } else if (step === 1) {
          img.dataset.retryStep = '2';
          img.src = 'https://pimg.1px.tw/' + noSuffixPath;
        } else if (step === 2) {
          img.dataset.retryStep = '3';
          img.src = 'https://pimg.1px.tw/blog/' + noSuffixPath;
        } else if (step === 3) {
          img.dataset.retryStep = '4';
          img.src = 'https://s.pixfs.net/' + cleanPath;
        } else if (step === 4) {
          img.dataset.retryStep = '5';
          img.src = 'https://wsrv.nl/?url=' + encodeURIComponent('pic.pimg.tw/' + noSuffixPath);
        } else if (step === 5) {
          img.dataset.retryStep = '6';
          img.src = 'https://web.archive.org/web/2/https://pic.pimg.tw/' + cleanPath;
        } else {
          img.style.display = 'none';
        }
      };
    </script>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
        background-color: #FAF6F0;
        color: #3D352E;
        padding-bottom: 90px;
      }

      /* 頂部閱讀進度條 */
      #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        width: 0%;
        height: 4px;
        background: linear-gradient(90deg, #C8AD90, #9C7A54);
        z-index: 99999;
      }

      /* 頂部動態跑馬燈 */
      .marquee-bar {
        background: #EFE6DD;
        color: #5C5046;
        font-size: 13.5px;
        font-weight: 600;
        padding: 8px 0;
        overflow: hidden;
        white-space: nowrap;
        border-bottom: 1px solid #E2D4C5;
      }
      .marquee-track {
        display: inline-block;
        padding-left: 100%;
        animation: marqueeMove 28s linear infinite;
      }
      @keyframes marqueeMove {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
      }

      /* 頂部導覽列 */
      .site-header {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #E6D5C3;
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 14px 28px;
      }
      .header-inner {
        max-width: 1240px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #3D352E;
        font-size: 22px;
        font-weight: 900;
      }
      .brand-logo img {
        height: 38px;
        width: 38px;
        border-radius: 50%;
        object-fit: cover;
      }
      .back-home-btn {
        background: #FAF6F0;
        border: 1px solid #C8AD90;
        color: #3D352E;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
      }

      /* 內頁雙欄佈局：左文章內容+相關文章，右完整側邊欄 */
      .post-layout {
        max-width: 1240px;
        margin: 28px auto 60px;
        padding: 0 20px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 32px;
        align-items: start;
      }
      @media (max-width: 980px) {
        .post-layout { grid-template-columns: 1fr; }
      }

      .article-container {
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 36px 40px;
        box-shadow: 0 4px 24px rgba(61, 53, 46, 0.05);
      }
      @media (max-width: 640px) {
        .article-container { padding: 22px 18px; }
      }
      .article-title-box {
        background: #F4ECE4;
        border-left: 6px solid #C8AD90;
        padding: 16px 22px;
        border-radius: 10px;
        margin-bottom: 18px;
      }
      .article-title-box h1 {
        margin: 0;
        font-size: 24px;
        line-height: 1.5;
        color: #3D352E;
      }
      .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-bottom: 28px;
        padding-bottom: 16px;
        border-bottom: 1px dashed #E6D5C3;
        font-size: 14px;
        color: #7A6E65;
      }
      .cat-tag {
        background: #C8AD90;
        color: #fff;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 600;
      }
      .views-tag {
        background: #FAF3EB;
        color: #9C7A54;
        border: 1px solid #E6D5C3;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 700;
      }
      .article-body {
        font-size: 17px;
        line-height: 1.95;
        color: #3D352E;
        overflow-wrap: break-word;
      }
      .article-body img {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 12px;
        margin: 18px auto !important;
        display: block !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      }
      .tags-footer {
        margin-top: 36px;
        padding-top: 20px;
        border-top: 1px solid #EFE6DD;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .tag-item {
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
        padding: 4px 12px;
        border-radius: 14px;
        font-size: 13px;
        color: #6E6259;
      }

      /* 底部相關文章推薦區塊 */
      .related-section {
        margin-top: 28px;
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 28px 32px;
        box-shadow: 0 4px 20px rgba(61, 53, 46, 0.04);
      }
      .related-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
        margin-top: 16px;
      }
      @media (max-width: 640px) {
        .related-grid { grid-template-columns: 1fr; }
      }
      .related-card {
        display: flex;
        flex-direction: column;
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: #3D352E;
        transition: transform 0.2s;
      }
      .related-card:hover {
        transform: translateY(-3px);
      }
      .related-card img {
        width: 100%;
        height: 150px;
        object-fit: cover;
      }
      .related-card-title {
        padding: 12px;
        font-size: 14.5px;
        font-weight: 700;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* 右側側邊欄 */
      .sidebar-column {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .sidebar-box {
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 24px 22px;
        box-shadow: 0 4px 20px rgba(61, 53, 46, 0.04);
      }
      .box-title {
        font-size: 16px;
        font-weight: 800;
        color: #3D352E;
        background: #F4ECE4;
        border-left: 4px solid #C8AD90;
        padding: 9px 14px;
        border-radius: 6px;
        margin: 0 0 16px 0;
      }
      .author-avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #E6D5C3;
        display: block;
        margin: 0 auto 12px;
      }
      .author-bio {
        font-size: 14px;
        line-height: 1.75;
        color: #5C5046;
        white-space: pre-line;
        margin-bottom: 14px;
      }
      .ig-btn {
        display: block;
        width: 100%;
        padding: 11px;
        background: #A98B6F;
        color: #FFFFFF;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 14px;
        text-align: center;
        margin-bottom: 12px;
      }
      .hits-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        text-align: center;
      }
      .hit-item {
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
        padding: 12px 8px;
        border-radius: 12px;
      }
      .hit-label { font-size: 12px; color: #7A6E65; margin-bottom: 4px; }
      .hit-num { font-size: 18px; font-weight: 800; color: #9C7A54; }
      .side-post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .side-post-item a {
        display: flex;
        gap: 10px;
        text-decoration: none;
        color: #4A4038;
        font-size: 13.5px;
        line-height: 1.5;
        padding: 6px 4px;
        border-bottom: 1px dashed #EFE6DD;
      }
      .rank-num {
        background: #C8AD90;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        min-width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      /* 回到頂部按鈕與管理員工具列 */
      #backToTop {
        position: fixed;
        bottom: 76px;
        right: 28px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #C8AD90;
        color: #FFFFFF;
        border: none;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9998;
      }
      .floating-admin-bar {
        position: fixed;
        bottom: 20px;
        right: 24px;
        z-index: 9999;
        background: rgba(38, 33, 29, 0.95);
        backdrop-filter: blur(8px);
        padding: 8px 14px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
      }
      .admin-pill {
        background: #FAF6F0;
        color: #3D352E;
        text-decoration: none;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
      }
      .admin-pill.gold { background: #E6C89C; }
    </style>
  </head>
  <body>
    <div id="reading-progress"></div>
    <div class="marquee-bar">
      <div class="marquee-track">{marqueeText}</div>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          {logoImg && <img src={logoImg} alt={siteTitle} referrerpolicy="no-referrer" onerror="this.style.display='none'" />}
          <span>{siteTitle}</span>
        </a>
        <a href="/" class="back-home-btn">← 返回文章列表首頁</a>
      </div>
    </header>

    <main class="post-layout">
      <div>
        <article class="article-container">
          <div class="article-title-box">
            <h1>{post.data.title}</h1>
          </div>

          <div class="article-meta">
            <span class="cat-tag">{post.data.category || '台灣美食'}</span>
            <span>📅 發布於 {dateStr}</span>
            <span class="views-tag">🔥 觀看人數：<span id="postViewCounter">{baseViews.toLocaleString()}</span> 次</span>
          </div>

          <div class="article-body" id="articleBody">
            <Content />
          </div>

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="tags-footer">
              {post.data.tags.map((t: string) => <span class="tag-item">#{t}</span>)}
            </div>
          )}
        </article>

        <!-- 底部相關文章推薦 -->
        {relatedPosts.length > 0 && (
          <section class="related-section">
            <h3 class="box-title">💡 延伸閱讀：相關文章推薦</h3>
            <div class="related-grid">
              {relatedPosts.map((rp: any) => (
                <a href={`/posts/${rp.slug}/`} class="related-card">
                  {rp.data.heroImage && (
                    <img
                      src={rp.data.heroImage}
                      alt={rp.data.title}
                      referrerpolicy="no-referrer"
                      onerror="window.recoverPixnetImg(this)"
                    />
                  )}
                  <div class="related-card-title">{rp.data.title}</div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- 內頁右側完整保留側邊欄 -->
      <aside class="sidebar-column">
        <div class="sidebar-box">
          <img
            src={authorAvatar}
            alt={authorName}
            class="author-avatar"
            referrerpolicy="no-referrer"
            onerror="this.src='https://pimg.1px.tw/blog/zhjun8699/logo/844863945586290081.webp'"
          />
          <p class="author-bio">{authorBio}</p>
          <a href={igUrl} target="_blank" class="ig-btn">📸 追蹤我的 Instagram</a>
        </div>

        <div class="sidebar-box">
          <h4 class="box-title">📊 參觀人氣統計</h4>
          <div class="hits-grid">
            <div class="hit-item">
              <div class="hit-label">本日人氣</div>
              <div class="hit-num" id="dailyHits">386</div>
            </div>
            <div class="hit-item">
              <div class="hit-label">累積人氣</div>
              <div class="hit-num" id="totalHits">{totalBaseViews.toLocaleString()}</div>
            </div>
          </div>
        </div>

        <div class="sidebar-box">
          <h4 class="box-title">🔥 熱門文章排行</h4>
          <ul class="side-post-list">
            {hotPosts.map((p: any, i: number) => (
              <li class="side-post-item">
                <a href={`/posts/${p.slug}/`}>
                  <span class="rank-num">{i + 1}</span>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="sidebar-box">
          <h4 class="box-title">✨ 最新發布文章</h4>
          <ul class="side-post-list">
            {latestPosts.map((p: any) => (
              <li class="side-post-item">
                <a href={`/posts/${p.slug}/`}>
                  <span>• {p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </main>

    <button id="backToTop" title="回到頂部">↑</button>

    <div class="floating-admin-bar">
      <a href={`/admin/#/collections/blog/entries/${post.slug}`} class="admin-pill gold">✏️ 編輯這篇文章</a>
      <a href="/admin/#/collections/blog/new" class="admin-pill">＋ 新增文章</a>
      <a href="/admin/" class="admin-pill">⚙️ 後台首頁</a>
    </div>

    <script is:inline define:vars={{ slug: post.slug, baseViews, totalBaseViews }}>
      // 閱讀進度條 & 回頂部
      const progressBar = document.getElementById('reading-progress');
      const backToTopBtn = document.getElementById('backToTop');
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) progressBar.style.width = percent + '%';
        if (backToTopBtn) backToTopBtn.style.display = scrollTop > 300 ? 'flex' : 'none';
      });
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // 觀看數 +1
      const key = 'views_' + slug;
      const currentExtra = parseInt(localStorage.getItem(key) || '0', 10) + 1;
      localStorage.setItem(key, String(currentExtra));
      const counterEl = document.getElementById('postViewCounter');
      if (counterEl) counterEl.textContent = (baseViews + currentExtra).toLocaleString();

      const todayKey = 'daily_hits_' + new Date().toISOString().slice(0, 10);
      const dailyVal = parseInt(localStorage.getItem(todayKey) || '386', 10) + 1;
      localStorage.setItem(todayKey, String(dailyVal));
      const dailyEl = document.getElementById('dailyHits');
      const totalEl = document.getElementById('totalHits');
      if (dailyEl) dailyEl.textContent = dailyVal.toLocaleString();
      if (totalEl) totalEl.textContent = (totalBaseViews + currentExtra + dailyVal).toLocaleString();

      // 內文圖片救援
      document.querySelectorAll('#articleBody img').forEach((img) => {
        img.setAttribute('referrerpolicy', 'no-referrer');
        img.addEventListener('error', function() { window.recoverPixnetImg(this); });
        if (img.complete && img.naturalWidth === 0) {
          window.recoverPixnetImg(img);
        }
      });
    </script>
  </body>
</html>
