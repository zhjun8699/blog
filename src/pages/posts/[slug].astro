---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();
const baseViews = post.data.baseViews || 5280;

// 相關文章推薦（同分類優先，最多 4 篇）
const relatedPosts = (allPosts || [])
  .filter((p: any) => !p.data.draft && p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 4);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-card" style="padding: 32px;">
    <div style="margin-bottom: 16px;">
      <a href="/" style="font-size: 0.9rem; color: var(--milk-tea-dark); text-decoration: none; font-weight: 600;">← 返回文章列表</a>
    </div>

    <h1 class="post-card-title" style="font-size: 1.65rem; margin-bottom: 14px;">
      {post.data.pinned && <span class="pinned-badge">📌 置頂精選</span>}
      {post.data.title}
    </h1>

    <div class="post-meta" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px dashed #E6D5C3;">
      <span class="category-badge">{post.data.category}</span>
      <span>📅 {new Date(post.data.pubDate).toLocaleDateString('zh-TW')}</span>
      <span style="background: #FAF3EB; color: #9C7A54; border: 1px solid #E6D5C3; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 0.88rem;">
        🔥 觀看人數：<span id="postViewCounter">{baseViews.toLocaleString()}</span> 次
      </span>
      {(post.data.tags || []).map((tag: string) => (
        <a href={`/?tag=${encodeURIComponent(tag)}`} class="tag-pill">#{tag}</a>
      ))}
    </div>

    <div class="article-content" id="articleBody" style="line-height: 1.95; font-size: 1.05rem;">
      <Content />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="post-card" style="margin-top: 24px; padding: 24px 28px;">
      <h3 style="margin: 0 0 16px 0; font-size: 1.15rem; padding-left: 12px; border-left: 4px solid #C8AD90;">💡 延伸閱讀：相關文章推薦</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;">
        {relatedPosts.map((rp: any) => (
          <a href={`/posts/${rp.slug}/`} style="text-decoration: none; color: inherit; background: var(--bg-main); border-radius: 10px; overflow: hidden; border: 1px solid #EFE6DD; display: flex; flex-direction: column;">
            {rp.data.heroImage && (
              <img src={rp.data.heroImage} alt={rp.data.title} loading="lazy" referrerpolicy="no-referrer" style="width: 100%; height: 140px; object-fit: cover;" />
            )}
            <div style="padding: 10px 12px; font-weight: 700; font-size: 0.92rem; line-height: 1.45;">
              {rp.data.title}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <script is:inline define:vars={{ slug: post.slug, baseViews }}>
    const key = 'views_' + slug;
    const currentExtra = parseInt(localStorage.getItem(key) || '0', 10) + 1;
    localStorage.setItem(key, String(currentExtra));
    const counterEl = document.getElementById('postViewCounter');
    if (counterEl) {
      counterEl.textContent = (baseViews + currentExtra).toLocaleString();
    }
  </script>
</BaseLayout>
