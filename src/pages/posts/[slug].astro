---
import { getCollection } from 'astro:content';
import siteConfig from '../../data/siteConfig.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
const d = new Date(post.data.pubDate);
const dateStr = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
const baseViews = post.data.baseViews || 5280;
const siteTitle = siteConfig.title || siteConfig.siteTitle || '哪裏。DOKO';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>{post.data.title} | {siteTitle}</title>
    <meta name="description" content={post.data.description} />
    <script is:inline>
      window.recoverPixnetImg = function(img) {
        if (!img) return;
        const step = parseInt(img.dataset.retryStep || '0', 10);
        const rawUrl = img.dataset.rawSrc || img.getAttribute('src') || '';
        if (!rawUrl) return;
        img.dataset.rawSrc = rawUrl;

        let cleanPath = rawUrl
          .replace(/^https?:\/\/[^/]+\//i, '')
          .replace(/^blog\//i, '');
        let noSuffixPath = cleanPath.replace(/_[nbmsq]\.(jpg|jpeg|png|gif|webp)/i, '.$1');

        if (step === 0) {
          img.dataset.retryStep = '1';
          img.src = 'https://pic.pimg.tw/' + noSuffixPath;
        } else if (step === 1) {
          img.dataset.retryStep = '2';
          img.src = 'https://pimg.1px.tw/' + noSuffixPath;
        } else if (step === 2) {
          img.dataset.retryStep = '3';
          img.src = 'https://pimg.1px.tw/blog/' + noSuffixPath;
        } else if (step === 3) {
          img.dataset.retryStep = '4';
          img.src = 'https://s.pixfs.net/' + cleanPath;
        } else if (step === 4) {
          img.dataset.retryStep = '5';
          img.src = 'https://wsrv.nl/?url=' + encodeURIComponent('pic.pimg.tw/' + noSuffixPath);
        } else if (step === 5) {
          img.dataset.retryStep = '6';
          img.src = 'https://web.archive.org/web/2/https://pic.pimg.tw/' + cleanPath;
        } else {
          img.style.display = 'none';
        }
      };
    </script>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
        background-color: #FAF6F0;
        color: #3D352E;
        padding-bottom: 80px;
      }
      .top-bar {
        background: #FFFFFF;
        border-bottom: 1px solid #E6D5C3;
        padding: 14px 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .top-bar-inner {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .back-btn {
        color: #3D352E;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        padding: 6px 14px;
        border-radius: 8px;
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
      }
      .article-container {
        max-width: 860px;
        margin: 32px auto 60px;
        background: #FFFFFF;
        border-radius: 18px;
        border: 1px solid #EFE6DD;
        padding: 36px 42px;
        box-shadow: 0 4px 24px rgba(61, 53, 46, 0.05);
      }
      @media (max-width: 640px) {
        .article-container { padding: 22px 18px; margin: 16px 12px; }
      }
      .article-title-box {
        background: #F4ECE4;
        border-left: 6px solid #C8AD90;
        padding: 16px 22px;
        border-radius: 10px;
        margin-bottom: 18px;
      }
      .article-title-box h1 {
        margin: 0;
        font-size: 24px;
        line-height: 1.5;
        color: #3D352E;
      }
      .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 28px;
        padding-bottom: 16px;
        border-bottom: 1px dashed #E6D5C3;
        font-size: 14px;
        color: #7A6E65;
      }
      .cat-tag {
        background: #C8AD90;
        color: #fff;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 600;
      }
      .views-tag {
        background: #FAF3EB;
        color: #9C7A54;
        border: 1px solid #E6D5C3;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 700;
      }
      .article-body {
        font-size: 17px;
        line-height: 1.95;
        color: #3D352E;
        overflow-wrap: break-word;
      }
      .article-body img {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 12px;
        margin: 18px auto !important;
        display: block !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      }
      .article-body p {
        margin: 14px 0;
      }
      .article-body a {
        color: #9C7A54;
        font-weight: 600;
      }
      .tags-footer {
        margin-top: 36px;
        padding-top: 20px;
        border-top: 1px solid #EFE6DD;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .tag-item {
        background: #FAF6F0;
        border: 1px solid #E6D5C3;
        padding: 4px 12px;
        border-radius: 14px;
        font-size: 13px;
        color: #6E6259;
      }
      .floating-admin-bar {
        position: fixed;
        bottom: 20px;
        right: 24px;
        z-index: 9999;
        background: rgba(38, 33, 29, 0.95);
        backdrop-filter: blur(8px);
        padding: 8px 14px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
      }
      .admin-pill {
        background: #FAF6F0;
        color: #3D352E;
        text-decoration: none;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
      }
      .admin-pill.gold {
        background: #E6C89C;
      }
    </style>
  </head>
  <body>
    <header class="top-bar">
      <div class="top-bar-inner">
        <a href="/" class="back-btn">← 返回 {siteTitle} 首頁</a>
        <a href={`/admin/#/collections/blog/entries/${post.slug}`} style="font-size:13px;color:#9C7A54;text-decoration:none;font-weight:700;">✏️ 在後台編輯此篇</a>
      </div>
    </header>

    <main class="article-container">
      <div class="article-title-box">
        <h1>{post.data.title}</h1>
      </div>

      <div class="article-meta">
        <span class="cat-tag">{post.data.category || '精選文章'}</span>
        <span>📅 發布於 {dateStr}</span>
        <span class="views-tag">🔥 觀看人數：<span id="postViewCounter">{baseViews.toLocaleString()}</span> 次</span>
      </div>

      <div class="article-body" id="articleBody">
        <Content />
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags-footer">
          {post.data.tags.map((t: string) => <span class="tag-item">#{t}</span>)}
        </div>
      )}
    </main>

    <div class="floating-admin-bar">
      <a href={`/admin/#/collections/blog/entries/${post.slug}`} class="admin-pill gold">✏️ 編輯這篇文章</a>
      <a href="/admin/#/collections/blog/new" class="admin-pill">＋ 新增文章</a>
      <a href="/admin/" class="admin-pill">⚙️ 後台首頁</a>
    </div>

    <script is:inline define:vars={{ slug: post.slug, baseViews }}>
      const key = 'views_' + slug;
      const currentExtra = parseInt(localStorage.getItem(key) || '0', 10) + 1;
      localStorage.setItem(key, String(currentExtra));
      const counterEl = document.getElementById('postViewCounter');
      if (counterEl) {
        counterEl.textContent = (baseViews + currentExtra).toLocaleString();
      }

      document.querySelectorAll('#articleBody img').forEach((img) => {
        img.setAttribute('referrerpolicy', 'no-referrer');
        img.addEventListener('error', function() { window.recoverPixnetImg(this); });
        if (img.complete && img.naturalWidth === 0) {
          window.recoverPixnetImg(img);
        }
      });
    </script>
  </body>
</html>
