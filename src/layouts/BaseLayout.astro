---
import { getCollection } from 'astro:content';
import siteConfig from '../data/siteConfig.json';

const { title, description, image, seo } = Astro.props;
const siteTitle = siteConfig.header.bannerTitle;

const finalTitle = (seo && seo.seoTitle) ? seo.seoTitle : (title ? `${title} | ${siteTitle}` : siteTitle);
const finalDesc = (seo && seo.seoDescription) ? seo.seoDescription : (description || siteConfig.header.bannerSubtitle);
const finalImage = (seo && seo.ogImage) ? seo.ogImage : image;

const { announcement, header, categories, sidebar, colors } = siteConfig;

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const tagCounts = {};
allPosts.forEach(post => {
  (post.data.tags || []).forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const allTags = Object.keys(tagCounts);
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDesc} />

    <link rel="icon" href={header.favicon || header.logoImage || "/favicon.svg"} />
    <link rel="apple-touch-icon" href={header.favicon || header.logoImage || "/favicon.svg"} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    {finalImage && <meta property="og:image" content={finalImage} />}

    <link rel="stylesheet" href="/styles/theme.css" />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <style define:vars={{
      bgMain: colors.bgMain,
      milkTeaBg: colors.milkTeaBg,
      milkTeaDark: colors.milkTeaDark,
    }}>
      :root {
        --bg-main: var(--bgMain);
        --milk-tea-bg: var(--milkTeaBg);
        --milk-tea-dark: var(--milkTeaDark);
      }
      .admin-floating-bar {
        position: fixed; bottom: 24px; right: 24px; background: #3D352E; color: #fff;
        padding: 10px 16px; border-radius: 50px; box-shadow: 0 6px 20px rgba(0,0,0,0.25);
        display: none; align-items: center; gap: 10px; z-index: 9999; font-size: 0.88rem; flex-wrap: wrap;
      }
      .admin-floating-bar a, .admin-floating-bar button {
        background: var(--milk-tea-bg); color: #3D352E; border: none; padding: 6px 13px;
        border-radius: 20px; font-weight: 700; cursor: pointer; font-size: 0.84rem; text-decoration: none;
      }
      .admin-floating-bar a:hover, .admin-floating-bar button:hover {
        background: var(--milk-tea-dark); color: #fff;
      }
    </style>
  </head>
  <body>
    <div id="reading-progress-bar"></div>

    {announcement && announcement.enabled && (
      <div class="top-announcement-bar">
        {announcement.link ? (
          <a href={announcement.link}>{announcement.text}</a>
        ) : (
          <span>{announcement.text}</span>
        )}
      </div>
    )}

    <header class="site-header">
      <div class="nav-container">
        <a href="/" class="site-logo">
          {header.logoImage ? (
            <img src={header.logoImage} alt={header.logoText} style="height: 42px; width: auto; vertical-align: middle;" />
          ) : (
            header.logoText
          )}
        </a>
        <nav class="category-nav">
          <a href="/">全部文章</a>
          {categories.map((cat) => (
            <a href={`/?category=${encodeURIComponent(cat.name)}`}>{cat.name}</a>
          ))}
        </nav>
        <div class="search-box">
          <input type="text" id="searchInput" placeholder="搜尋文章關鍵字..." />
        </div>
      </div>
    </header>

    <section 
      class="hero-banner" 
      style={header.bannerBgImage ? `background: linear-gradient(rgba(61, 53, 46, 0.45), rgba(61, 53, 46, 0.45)), url('${header.bannerBgImage}') center/cover no-repeat; color: #fff;` : ''}
    >
      <h1>{header.bannerTitle}</h1>
      <p style={header.bannerBgImage ? 'color: #fff;' : ''}>{header.bannerSubtitle}</p>
    </section>

    <div class="main-container">
      <main class="content-column">
        <slot />
      </main>

      <aside class="sidebar-column">
        <div class="widget-card">
          <h3 class="widget-title">{sidebar.profileTitle}</h3>
          {sidebar.avatar && <img src={sidebar.avatar} alt="Avatar" class="profile-avatar" />}
          <p style="font-size: 0.95rem; margin-bottom: 12px; white-space: pre-line;">{sidebar.bio}</p>
          <div style="font-size: 0.88rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 10px;">
            {sidebar.contactNote}
          </div>
          {sidebar.igAccount && (
            <a href={`https://www.instagram.com/${sidebar.igAccount}/`} target="_blank" rel="noopener noreferrer" class="ig-follow-btn">
              📸 追蹤我的 IG (@{sidebar.igAccount})
            </a>
          )}
        </div>

        {sidebar.showIgFeed && sidebar.igAccount && (
          <div class="widget-card">
            <h3 class="widget-title">Instagram 最新動態</h3>
            <div style="border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color);">
              <iframe 
                src={`https://www.instagram.com/${sidebar.igAccount}/embed`} 
                width="100%" 
                height="420" 
                frameborder="0" 
                scrolling="no" 
                allowtransparency="true">
              </iframe>
            </div>
          </div>
        )}

        {allTags.length > 0 && (
          <div class="widget-card">
            <h3 class="widget-title">🏷️ 熱門話題標籤</h3>
            <div class="tag-cloud">
              {allTags.map(tag => (
                <a href={`/?tag=${encodeURIComponent(tag)}`} class="tag-pill">
                  #{tag} ({tagCounts[tag]})
                </a>
              ))}
            </div>
          </div>
        )}

        {sidebar.showSidebarAd && (
          <div class="widget-card">
            <h3 class="widget-title">精選推薦 / 廣告</h3>
            <div class="ad-slot" set:html={sidebar.sidebarAdContent} />
          </div>
        )}
      </aside>
    </div>

    <button id="backToTopBtn" title="回到頂部">↑</button>

    <div id="adminFloatingBar" class="admin-floating-bar">
      <span>🛡️ 管理員模式</span>
      <a href="/admin/#/collections/blog/new">➕ 新增文章</a>
      <a href="/admin/#/collections/settings/entries/site_config">🎨 修改版面/圖片/分類</a>
      <a href="/admin/">⚙️ 後台首頁</a>
      <button id="adminLogoutBtn">登出</button>
    </div>

    <footer class="site-footer">
      <p>
        &copy; {new Date().getFullYear()} {header.logoText}. All Rights Reserved. | 
        <a href="javascript:void(0)" id="adminLoginTrigger" style="color: var(--text-muted); text-decoration: underline;">管理員登入 (支援2FA)</a>
      </p>
    </footer>

    <script is:inline>
      const adminBar = document.getElementById('adminFloatingBar');
      const loginTrigger = document.getElementById('adminLoginTrigger');
      const logoutBtn = document.getElementById('adminLogoutBtn');

      function showAdminFeatures() {
        adminBar.style.display = 'flex';
        loginTrigger.innerText = '進入管理後台';
        document.querySelectorAll('.admin-click-stats').forEach(el => {
          el.style.display = 'inline-block';
        });
      }

      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', user => {
          if (user) showAdminFeatures();
        });
        window.netlifyIdentity.on('login', () => {
          showAdminFeatures();
          window.netlifyIdentity.close();
        });
        window.netlifyIdentity.on('logout', () => {
          adminBar.style.display = 'none';
          window.location.reload();
        });
        loginTrigger.addEventListener('click', () => {
          const currentUser = window.netlifyIdentity.currentUser();
          if (currentUser) {
            window.location.href = '/admin/';
          } else {
            window.netlifyIdentity.open('login');
          }
        });
        logoutBtn.addEventListener('click', () => {
          window.netlifyIdentity.logout();
        });
      }

      const progressBar = document.getElementById('reading-progress-bar');
      const backToTopBtn = document.getElementById('backToTopBtn');
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) progressBar.style.width = progress + '%';
        if (backToTopBtn) backToTopBtn.style.display = scrollTop > 300 ? 'flex' : 'none';
      });
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', () => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }

      document.addEventListener('contextmenu', e => e.preventDefault());
      document.addEventListener('dragstart', e => { if (e.target.tagName === 'IMG') e.preventDefault(); });
      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && ['s', 'S', 'u', 'U'].includes(e.key)) e.preventDefault();
      });
    </script>
  </body>
</html>
